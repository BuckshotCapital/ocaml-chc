# Toolchain via flake.nix: ocaml + dune + clickhouse (for the round-trip tests).
# No opam switch needed — the library is stdlib-only and the C stubs link
# nothing beyond libc.
use flake

# Live-server tests (test/test_client.ml) are opt-in: unset, they report skipped
# and pass. Put real values in .envrc.local, which is gitignored — nothing about
# any particular instance belongs in this file.
export CHC_TEST_HOST=""
export CHC_TEST_PORT="9000"
export CHC_TEST_USER="default"
export CHC_TEST_PASSWORD=""
export CHC_TEST_DATABASE="default"

source_env_if_exists .envrc.local
