(library
 (name chc)
 (public_name chc)
 ; ipaddr is optional. (select) picks the backend by availability; chc_ip.mli
 ; keeps both interchangeable, so the public API is `string` either way and the
 ; dependency never reaches Chc.value. Query which one is live via
 ; Chc.ip_backend.
 (libraries
  unix
  (select
   chc_ip.ml
   from
   (ipaddr -> chc_ip.ipaddr.ml)
   (-> chc_ip.fallback.ml)))
 (foreign_stubs
  (language c)
  (names chc_stubs)
  (include_dirs %{project_root}/vendor/clickhouse-c)
  ; The CHC_* configuration macros live in chc_stubs.c so the translation unit
  ; is self-describing; setting them here too only earns -Wmacro-redefined.
  (flags
   (:standard -std=c11)))
 ; Block compression codecs. The client still negotiates CHC_COMP_NONE unless a
 ; codec is passed at connect time, so these are latent until asked for.
 (c_library_flags
  (-llz4 -lzstd)))
